rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  REGRAS DE SEGURANÇA — versão com duas gavetas (privada/pública)
//
//  Agora os dados pessoais estão protegidos de verdade:
//
//  - 'agendamentos' (PRIVADA): tem email do cliente. Só o DONO do
//    agendamento e a EQUIPE podem ler. Um cliente não vê os dados
//    de outro cliente — nem mexendo nas ferramentas do navegador.
//
//  - 'ocupacoes' (PÚBLICA): só horário/duração/status, SEM nada
//    pessoal. Qualquer cliente logado pode ler (é o que o cálculo de
//    horários livres precisa). Como não há email nem nome aqui, ler
//    isto não expõe ninguém.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehStaff() {
      return logado()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.staff == true;
    }

    // ── Gaveta PRIVADA: dados completos do agendamento ────────
    match /agendamentos/{id} {
      // Ler: só o dono do agendamento ou a equipe. (Aqui está o email;
      // por isso a leitura é restrita — fecha a brecha de privacidade.)
      allow read: if logado() && (resource.data.clienteUid == request.auth.uid || ehStaff());

      // Criar: o próprio cliente, em seu nome, sempre como "pendente".
      allow create: if logado()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.status == 'pendente';

      // Atualizar: equipe pode tudo; o dono só pode CANCELAR o seu.
      allow update: if ehStaff()
        || (
          logado()
          && resource.data.clienteUid == request.auth.uid
          && request.resource.data.status == 'cancelado'
        );

      allow delete: if ehStaff();
    }

    // ── Gaveta PÚBLICA: só horário/duração/status ─────────────
    match /ocupacoes/{id} {
      // Ler: qualquer logado (necessário para calcular horários livres).
      // Não há dado pessoal aqui, então isto não expõe ninguém.
      allow read: if logado();

      // Criar: o cliente cria a ocupação junto com o agendamento dele,
      // sempre como "pendente".
      allow create: if logado()
        && request.resource.data.status == 'pendente';

      // Atualizar: equipe (aprovar/recusar/concluir) ou o próprio
      // cliente cancelando. Como a ocupação não guarda o dono, exigimos
      // que o documento privado correspondente seja do cliente OU staff.
      allow update: if ehStaff()
        || (
          logado()
          && request.resource.data.status == 'cancelado'
          && get(/databases/$(database)/documents/agendamentos/$(id)).data.clienteUid == request.auth.uid
        );

      allow delete: if ehStaff();
    }

    // ── Perfis de cliente ─────────────────────────────────────
    match /clientes/{uid} {
      allow read: if logado() && (uid == request.auth.uid || ehStaff());
      allow create, update: if logado() && uid == request.auth.uid;
      allow delete: if false;
    }

    // ── Configurações da barbearia (WhatsApp, aviso) ──────────
    // Leitura liberada (o botão de WhatsApp e o aviso aparecem para o
    // cliente; não há nada sensível). Escrita só pela equipe.
    match /config/{doc} {
      allow read: if true;
      allow write: if ehStaff();
    }

    // ── Marcação de equipe ────────────────────────────────────
    match /roles/{uid} {
      allow read: if logado() && uid == request.auth.uid;
      allow write: if false;
    }
  }
}
