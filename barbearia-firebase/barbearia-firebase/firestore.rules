rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  REGRAS DE SEGURANÇA DO FIRESTORE
//
//  Isto roda nos servidores do Google e NÃO pode ser burlado pelo
//  navegador. É o que substitui o antigo backend C# na proteção
//  dos dados. Cole este conteúdo em:
//  Firebase Console → Firestore → Aba "Regras" → Publicar.
//
//  Resumo do que cada regra garante:
//  - Um cliente só lê e mexe nos PRÓPRIOS agendamentos.
//  - Só a equipe (staff) vê todos os agendamentos e muda status.
//  - Ninguém lê o perfil de outro cliente.
//  - A marcação de quem é staff (roles) é só de leitura pelo app;
//    você define quem é staff manualmente no Console.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Um usuário é staff se existir roles/{seuId} com staff = true.
    function ehStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.staff == true;
    }

    function logado() {
      return request.auth != null;
    }

    // ── Agendamentos ──────────────────────────────────────────
    match /agendamentos/{id} {
      // Ler: o dono do agendamento, ou qualquer membro da equipe.
      allow read: if logado() && (resource.data.clienteUid == request.auth.uid || ehStaff());

      // Criar: qualquer cliente logado, mas só em nome de si mesmo,
      // e o status inicial é obrigatoriamente "pendente".
      allow create: if logado()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.status == 'pendente';

      // Atualizar:
      //  - a equipe pode mudar qualquer coisa (aprovar, recusar, concluir);
      //  - o cliente dono só pode CANCELAR o próprio agendamento.
      allow update: if ehStaff()
        || (
          logado()
          && resource.data.clienteUid == request.auth.uid
          && request.resource.data.status == 'cancelado'
        );

      // Ninguém apaga agendamentos (mantém histórico). Só a equipe, se precisar.
      allow delete: if ehStaff();
    }

    // ── Perfis de cliente ─────────────────────────────────────
    match /clientes/{uid} {
      // Cada cliente lê/escreve só o próprio perfil; a equipe pode ler todos.
      allow read: if logado() && (uid == request.auth.uid || ehStaff());
      allow create, update: if logado() && uid == request.auth.uid;
      allow delete: if false;
    }

    // ── Marcação de equipe (roles) ────────────────────────────
    // O app só LÊ para saber se você é staff. Definir quem é staff
    // é feito manualmente por você no Console (nunca pelo app).
    match /roles/{uid} {
      allow read: if logado() && uid == request.auth.uid;
      allow write: if false;
    }
  }
}
